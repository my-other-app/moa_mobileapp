<?xml version="1.0" encoding="utf-8"?>
<!-- "Next up", small (2x2): the date and the event's name, and when it is.
     NextUpWidgetProvider fills it; until then (and signed out) it asks the
     person to sign in. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/next_up_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_next_up_background"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/next_up_event"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_next_up_date"
                android:gravity="center_horizontal"
                android:minWidth="44dp"
                android:orientation="vertical"
                android:paddingLeft="6dp"
                android:paddingTop="3dp"
                android:paddingRight="6dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/next_up_weekday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:textColor="@color/next_up_date_ink"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/next_up_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:includeFontPadding="false"
                    android:textColor="@color/next_up_date_ink"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/next_up_month"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:textColor="@color/next_up_date_ink"
                    android:textSize="9sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/next_up_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="end"
                android:maxLines="2"
                android:text="@string/next_up_label"
                android:textAllCaps="true"
                android:textColor="@color/next_up_accent"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/next_up_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:textColor="@color/next_up_ink"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/next_up_when"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/next_up_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/next_up_message"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/next_up_brand"
            android:textAllCaps="true"
            android:textColor="@color/next_up_accent"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/next_up_message_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="3"
            android:text="@string/next_up_signed_out"
            android:textColor="@color/next_up_ink"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/next_up_message_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/widget_next_up_pill"
            android:fontFamily="sans-serif-medium"
            android:paddingLeft="12dp"
            android:paddingTop="5dp"
            android:paddingRight="12dp"
            android:paddingBottom="5dp"
            android:text="@string/next_up_sign_in"
            android:textColor="@color/next_up_pill_ink"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
