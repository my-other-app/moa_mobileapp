<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows for "Networking" (Android 12+): the small
     widget, with the placeholder where the person's code will be. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_next_up_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="10dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/networking_qr_description"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_networking_placeholder" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/networking_sample_name"
        android:textColor="@color/next_up_ink"
        android:textSize="12sp" />
</LinearLayout>
