<?xml version="1.0" encoding="utf-8"?>
<!-- "For you", medium (4x2): the header ("For you", "This week near you"...)
     with "See all", and two events, each a row with its date (Bebas Neue,
     drawn by the provider), its name, and its time, club and place.
     ForYouWidgetProvider fills it; each row opens the event's page. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/for_you_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_next_up_background"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/for_you_events"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/for_you_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/for_you_label"
                android:textAllCaps="true"
                android:textColor="@color/next_up_accent"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/for_you_see_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="8dp"
                android:text="@string/for_you_see_all"
                android:textColor="@color/next_up_accent"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/for_you_row_0"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/for_you_row_0_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_next_up_date"
                android:contentDescription="@string/next_up_date_unknown"
                android:paddingLeft="6dp"
                android:paddingTop="6dp"
                android:paddingRight="6dp"
                android:paddingBottom="5dp"
                android:scaleType="center" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/for_you_row_0_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/next_up_ink"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/for_you_row_0_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/next_up_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
        <View
            android:id="@+id/for_you_divider_1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="@color/next_up_divider" />
        <LinearLayout
            android:id="@+id/for_you_row_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/for_you_row_1_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_next_up_date"
                android:contentDescription="@string/next_up_date_unknown"
                android:paddingLeft="6dp"
                android:paddingTop="6dp"
                android:paddingRight="6dp"
                android:paddingBottom="5dp"
                android:scaleType="center" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/for_you_row_1_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/next_up_ink"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/for_you_row_1_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/next_up_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Nothing on (or nothing read yet): a calm "Find events". -->
    <LinearLayout
        android:id="@+id/for_you_message"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/for_you_label"
            android:textAllCaps="true"
            android:textColor="@color/next_up_accent"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:text="@string/for_you_nothing"
            android:textColor="@color/next_up_ink"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:text="@string/for_you_nothing_more"
            android:textColor="@color/next_up_secondary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/widget_next_up_pill"
            android:fontFamily="sans-serif-medium"
            android:paddingLeft="12dp"
            android:paddingTop="4dp"
            android:paddingRight="12dp"
            android:paddingBottom="4dp"
            android:text="@string/next_up_find_events"
            android:textColor="@color/next_up_pill_ink"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
