<?xml version="1.0" encoding="utf-8"?>
<!-- "Next up", large (about 4x4): the next three events, each a row with
     its date (Bebas Neue, drawn by the provider), when, its name and its
     place; the first with "Show ticket" (or "Under review"). Each row opens
     its own ticket. NextUpWidgetProvider fills it; until then (and signed
     out) it asks the person to sign in. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/next_up_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_next_up_background"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/next_up_event"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/next_up_label"
            android:textAllCaps="true"
            android:textColor="@color/next_up_accent"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/next_up_row_0"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/next_up_row_0_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_next_up_date"
                android:contentDescription="@string/next_up_date_unknown"
                android:paddingLeft="7dp"
                android:paddingTop="7dp"
                android:paddingRight="7dp"
                android:paddingBottom="6dp"
                android:scaleType="center" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/next_up_row_0_when"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/next_up_accent"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/next_up_row_0_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/next_up_ink"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/next_up_row_0_place"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/next_up_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp">

                <TextView
                    android:id="@+id/next_up_show_ticket"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_next_up_pill"
                    android:fontFamily="sans-serif-medium"
                    android:paddingLeft="12dp"
                    android:paddingTop="4dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="4dp"
                    android:text="@string/next_up_show_ticket"
                    android:textColor="@color/next_up_pill_ink"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/next_up_review"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_next_up_review"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:paddingLeft="12dp"
                    android:paddingTop="4dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="4dp"
                    android:text="@string/next_up_under_review"
                    android:textColor="@color/next_up_review_ink"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <View
            android:id="@+id/next_up_divider_1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="@color/next_up_divider" />

        <LinearLayout
            android:id="@+id/next_up_row_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/next_up_row_1_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_next_up_date"
                android:contentDescription="@string/next_up_date_unknown"
                android:paddingLeft="7dp"
                android:paddingTop="7dp"
                android:paddingRight="7dp"
                android:paddingBottom="6dp"
                android:scaleType="center" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/next_up_row_1_when"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/next_up_accent"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/next_up_row_1_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/next_up_ink"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/next_up_row_1_place"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/next_up_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/next_up_divider_2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="@color/next_up_divider" />

        <LinearLayout
            android:id="@+id/next_up_row_2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/next_up_row_2_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_next_up_date"
                android:contentDescription="@string/next_up_date_unknown"
                android:paddingLeft="7dp"
                android:paddingTop="7dp"
                android:paddingRight="7dp"
                android:paddingBottom="6dp"
                android:scaleType="center" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/next_up_row_2_when"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/next_up_accent"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/next_up_row_2_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/next_up_ink"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/next_up_row_2_place"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/next_up_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/next_up_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:paddingTop="4dp"
            android:paddingBottom="2dp"
            android:text="@string/next_up_find_more"
            android:textColor="@color/next_up_accent"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/next_up_message"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/next_up_brand"
            android:textAllCaps="true"
            android:textColor="@color/next_up_accent"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/next_up_message_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="3"
            android:text="@string/next_up_signed_out"
            android:textColor="@color/next_up_ink"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/next_up_message_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/widget_next_up_pill"
            android:fontFamily="sans-serif-medium"
            android:paddingLeft="14dp"
            android:paddingTop="5dp"
            android:paddingRight="14dp"
            android:paddingBottom="5dp"
            android:text="@string/next_up_sign_in"
            android:textColor="@color/next_up_pill_ink"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
