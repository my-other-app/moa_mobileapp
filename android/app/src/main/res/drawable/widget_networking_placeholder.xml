<?xml version="1.0" encoding="utf-8"?>
<!-- "Networking" with no code yet: a soft square with a QR glyph, where the
     code will be. Sized so it scales to fit like the code. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="120dp"
        android:height="120dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/networking_soft" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item
        android:width="36dp"
        android:height="36dp"
        android:drawable="@drawable/widget_networking_glyph"
        android:gravity="center" />
</layer-list>
