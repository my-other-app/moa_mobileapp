<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup on Android 11 and earlier. The session lives in
     flutter_secure_storage's two preference files, encrypted with a key that
     never leaves this phone's keystore: restored on another phone they could
     not be read. Left out, a restored app simply starts signed out. -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
</full-backup-content>
