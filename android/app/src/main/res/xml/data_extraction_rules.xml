<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and phone-to-phone transfer on Android 12 and later: the same
     files left out as in backup_rules.xml (see there for why). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
        <exclude domain="file" path="gate_queue" />
        <exclude domain="file" path="documents" />
        <exclude domain="file" path="network_saves.json" />
        <exclude domain="sharedpref" path="HomeWidgetPreferences.xml" />
        <exclude domain="file" path="home_widget" />
        <exclude domain="root" path="app_flutter" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
        <exclude domain="file" path="gate_queue" />
        <exclude domain="file" path="documents" />
        <exclude domain="file" path="network_saves.json" />
        <exclude domain="sharedpref" path="HomeWidgetPreferences.xml" />
        <exclude domain="file" path="home_widget" />
        <exclude domain="root" path="app_flutter" />
    </device-transfer>
</data-extraction-rules>
