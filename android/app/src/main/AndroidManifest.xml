<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

  <!-- Needed for launching URLs -->
  <uses-permission android:name="android.permission.INTERNET"/>

  <!-- open_filex declares these for opening files in shared storage. The app
       only opens the ticket PDF it saved in its own documents directory,
       which needs none of them, and Google Play rejects READ_MEDIA_IMAGES /
       READ_MEDIA_VIDEO without a core need for the photo library. -->
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove"/>
  <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove"/>
  <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove"/>
  <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" tools:node="remove"/>

  <!-- No advertising ID (owner decision, 2026-10): the app shows no ads.
       Firebase Analytics merges these in; they are removed, and its
       collection of the ID is off below. Play Console's Advertising ID
       declaration is then "No". -->
  <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove"/>
  <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove"/>
  <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove"/>

  <!-- REQUIRED FOR ANDROID 11+ to access external apps -->
  <queries>
      <!-- For launching HTTP/HTTPS URLs in browser -->
      <intent>
          <action android:name="android.intent.action.VIEW" />
          <data android:scheme="http" />
      </intent>
      <intent>
          <action android:name="android.intent.action.VIEW" />
          <data android:scheme="https" />
      </intent>

      <!-- For launching WhatsApp -->
      <package android:name="com.whatsapp" />

      <!-- For Settings > Contact Support (mailto:support@myotherapp.in) -->
      <intent>
          <action android:name="android.intent.action.SENDTO" />
          <data android:scheme="mailto" />
      </intent>

      <!-- For phone calls -->
      <intent>
          <action android:name="android.intent.action.VIEW" />
          <data android:scheme="tel" />
      </intent>

      <!-- For sending SMS -->
      <intent>
          <action android:name="android.intent.action.VIEW" />
          <data android:scheme="sms" />
      </intent>

      <!-- Keep existing process text (used by Flutter text plugin) -->
      <intent>
          <action android:name="android.intent.action.PROCESS_TEXT"/>
          <data android:mimeType="text/plain"/>
      </intent>
  </queries>

  <application
      android:label="MyOtherApp"
      android:name="${applicationName}"
      android:icon="@mipmap/ic_launcher"
      android:fullBackupContent="@xml/backup_rules"
      android:dataExtractionRules="@xml/data_extraction_rules"
      tools:targetApi="31">

      <!-- Google Sign-In Client ID -->
      <meta-data
          android:name="com.google.android.gms.client_id"
          android:value="497245325238-ceiht9g22u4eh9a3mdkmfbssa0fkevt1.apps.googleusercontent.com" />
      
      <activity
          android:name=".MainActivity"
          android:exported="true"
          android:launchMode="singleTop"
          android:taskAffinity=""
          android:theme="@style/LaunchTheme"
          android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
          android:hardwareAccelerated="true"
          android:windowSoftInputMode="adjustResize">
          
          <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme" />
          
          <intent-filter>
              <action android:name="android.intent.action.MAIN"/>
              <category android:name="android.intent.category.LAUNCHER"/>
          </intent-filter>

          <!-- App Links: the website's pages the app has (web_links.dart),
               verified against https://myotherapp.in/.well-known/assetlinks.json.
               Only the apex: www. and events. redirect to it. The same
               paths the site's files claim (moa_events src/seo/appLinks.js
               APP_PATHS). /events/{slug}/live, the live room, is under
               /events/; /play/{event} is the quiz's QR on the big screen,
               which opens the quiz in the app; /claim/{token} is a
               waiting list's offer. An intent filter cannot
               leave a path out: the router sends what it can't show to
               the browser. -->
          <intent-filter android:autoVerify="true">
              <action android:name="android.intent.action.VIEW"/>
              <category android:name="android.intent.category.DEFAULT"/>
              <category android:name="android.intent.category.BROWSABLE"/>
              <data android:scheme="https"/>
              <data android:host="myotherapp.in"/>
              <data android:path="/events"/>
              <data android:pathPrefix="/events/"/>
              <data android:path="/clubs"/>
              <data android:pathPrefix="/clubs/"/>
              <data android:path="/threads"/>
              <data android:pathPrefix="/threads/"/>
              <data android:path="/topics"/>
              <data android:pathPrefix="/topics/"/>
              <data android:pathPrefix="/tickets/"/>
              <data android:pathPrefix="/claim/"/>
              <data android:pathPrefix="/certificates/"/>
              <data android:pathPrefix="/feedback/"/>
              <data android:pathPrefix="/play/"/>
          </intent-filter>
      </activity>

      <!-- Links reach the app's router (go_router) as routes. On by default
           in current Flutter; said here so it stays on. -->
      <meta-data
          android:name="flutter_deeplinking_enabled"
          android:value="true" />

      <!-- Pushes the system shows itself (the app in the background) use
           the app's channel, status-bar icon and accent, not the fallback
           "Miscellaneous" channel and the launcher icon. The channel is
           created at start-up (NotificationService.androidChannelId). -->
      <meta-data
          android:name="com.google.firebase.messaging.default_notification_channel_id"
          android:value="high_importance_channel" />
      <meta-data
          android:name="com.google.firebase.messaging.default_notification_icon"
          android:resource="@drawable/ic_stat_notification" />
      <meta-data
          android:name="com.google.firebase.messaging.default_notification_color"
          android:resource="@color/notification_accent" />

      <!-- Firebase Analytics: no advertising ID (see the permissions above). -->
      <meta-data
          android:name="google_analytics_adid_collection_enabled"
          android:value="false" />

      <!-- Required for Flutter plugin -->
      <meta-data
          android:name="flutterEmbedding"
          android:value="2" />
  </application>

</manifest>
