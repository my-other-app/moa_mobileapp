<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

  <!-- Needed for launching URLs -->
  <uses-permission android:name="android.permission.INTERNET"/>

  <!-- open_filex declares these for opening files in shared storage. The app
       only opens the ticket PDF it saved in its own documents directory,
       which needs none of them, and Google Play rejects READ_MEDIA_IMAGES /
       READ_MEDIA_VIDEO without a core need for the photo library. -->
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove"/>
  <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove"/>
  <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove"/>
  <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" tools:node="remove"/>

  <!-- REQUIRED FOR ANDROID 11+ to access external apps -->
  <queries>
      <!-- For launching HTTP/HTTPS URLs in browser -->
      <intent>
          <action android:name="android.intent.action.VIEW" />
          <data android:scheme="http" />
      </intent>
      <intent>
          <action android:name="android.intent.action.VIEW" />
          <data android:scheme="https" />
      </intent>

      <!-- For launching WhatsApp -->
      <package android:name="com.whatsapp" />

      <!-- For Settings > Contact Support (mailto:support@myotherapp.in) -->
      <intent>
          <action android:name="android.intent.action.SENDTO" />
          <data android:scheme="mailto" />
      </intent>

      <!-- For phone calls -->
      <intent>
          <action android:name="android.intent.action.VIEW" />
          <data android:scheme="tel" />
      </intent>

      <!-- For sending SMS -->
      <intent>
          <action android:name="android.intent.action.VIEW" />
          <data android:scheme="sms" />
      </intent>

      <!-- Keep existing process text (used by Flutter text plugin) -->
      <intent>
          <action android:name="android.intent.action.PROCESS_TEXT"/>
          <data android:mimeType="text/plain"/>
      </intent>
  </queries>

  <application
      android:label="MyOtherApp"
      android:name="${applicationName}"
      android:icon="@mipmap/ic_launcher">
      
      <!-- Google Sign-In Client ID -->
      <meta-data
          android:name="com.google.android.gms.client_id"
          android:value="497245325238-ceiht9g22u4eh9a3mdkmfbssa0fkevt1.apps.googleusercontent.com" />
      
      <activity
          android:name=".MainActivity"
          android:exported="true"
          android:launchMode="singleTop"
          android:taskAffinity=""
          android:theme="@style/LaunchTheme"
          android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
          android:hardwareAccelerated="true"
          android:windowSoftInputMode="adjustResize">
          
          <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme" />
          
          <intent-filter>
              <action android:name="android.intent.action.MAIN"/>
              <category android:name="android.intent.category.LAUNCHER"/>
          </intent-filter>
      </activity>

      <!-- Required for Flutter plugin -->
      <meta-data
          android:name="flutterEmbedding"
          android:value="2" />
  </application>

</manifest>
